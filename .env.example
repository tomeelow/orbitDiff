# Copy to .env and fill in. Never commit .env.
#
# Nothing is required yet: Earth Search needs no key, and Planetary Computer issues an
# anonymous read token on request. Secrets are added here in the phase that needs them
# (object storage keys, the email provider key, the feedback-link signing key).

# Optional: use a different pipeline parameter file (default: config/pipeline.toml).
# ORBITDIFF_PIPELINE_CONFIG=config/pipeline.toml

# Development defaults match docker-compose.yml.
# ORBITDIFF_DATA_DIR=data
# ORBITDIFF_DATABASE_URL=postgresql+psycopg://orbitdiff:orbitdiff@localhost:5433/orbitdiff
# ORBITDIFF_REDIS_URL=redis://localhost:6379/0
# ORBITDIFF_TITILER_URL=http://localhost:8001
# ORBITDIFF_TITILER_DATA_DIR=/data

# Tests that need Postgres run only when this is set (CI sets it).
# ORBITDIFF_TEST_DATABASE_URL=postgresql+psycopg://orbitdiff:orbitdiff@localhost:5433/orbitdiff_test
