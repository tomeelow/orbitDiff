# Copy to .env and fill in. Never commit .env.
#
# Earth Search needs no key, and Planetary Computer issues an anonymous read token on
# request. Secrets are added here in the phase that needs them (object storage keys and
# the email provider's credentials arrive with deployment, Phase 11).

# Required for alert emails: signs their "Not a real change" links. A secret: generate
# one per environment and never reuse it, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ORBITDIFF_SIGNING_KEY=

# Where links in emails point, as the browser reaches them. Sign-in links go to the API,
# which sets the session cookie and sends the browser on to the web app.
# ORBITDIFF_WEB_URL=http://localhost:5173
# ORBITDIFF_API_URL=http://localhost:8000

# Development sends every email to Mailpit (docker compose up mailpit; read them at
# http://localhost:8025). Nothing reaches a real inbox.
# ORBITDIFF_SMTP_HOST=localhost
# ORBITDIFF_SMTP_PORT=1025
# ORBITDIFF_MAIL_FROM=Orbit Diff <alerts@orbitdiff.localhost>

# Optional: use a different pipeline parameter file (default: config/pipeline.toml).
# ORBITDIFF_PIPELINE_CONFIG=config/pipeline.toml

# Development defaults match docker-compose.yml.
# ORBITDIFF_DATA_DIR=data
# ORBITDIFF_DATABASE_URL=postgresql+psycopg://orbitdiff:orbitdiff@localhost:5433/orbitdiff
# ORBITDIFF_REDIS_URL=redis://localhost:6379/0
# ORBITDIFF_TITILER_URL=http://localhost:8001
# ORBITDIFF_TITILER_DATA_DIR=/data

# Tests that need Postgres run only when this is set (CI sets it).
# ORBITDIFF_TEST_DATABASE_URL=postgresql+psycopg://orbitdiff:orbitdiff@localhost:5433/orbitdiff_test
