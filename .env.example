# Copy to .env and fill in. Never commit .env.
#
# Nothing is required yet: Earth Search needs no key, and Planetary Computer issues an
# anonymous read token on request. Secrets are added here in the phase that needs them
# (object storage keys, the email provider key, the feedback-link signing key).

# Optional: use a different pipeline parameter file (default: config/pipeline.toml).
# ORBITDIFF_PIPELINE_CONFIG=config/pipeline.toml
