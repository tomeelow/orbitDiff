# Settings for a deployment. deploy/setup.sh copies this to deploy/.env on the machine, asks
# for what's empty and generates the two secrets. Or fill deploy/.env in yourself first, and
# setup.sh asks nothing. Never commit deploy/.env. Runbook: docs/deploy.md.

# --- The site ----------------------------------------------------------------------------
# The domain whose DNS A record points at this machine. Caddy gets its certificate.
ORBITDIFF_DOMAIN=

# Which release runs, and where its images are. Leave both empty: setup.sh uses the newest
# version tag and ghcr.io/<the repository's owner>, and update.sh keeps the version current.
# Images the registry doesn't have, or won't hand over, are built on this machine instead.
ORBITDIFF_REGISTRY=
ORBITDIFF_VERSION=

# --- Secrets -------------------------------------------------------------------------------
# Leave empty: setup.sh generates each with `openssl rand -hex 32`. Hex, because the
# password goes inside a URL.
POSTGRES_PASSWORD=
ORBITDIFF_SIGNING_KEY=

# --- Who --------------------------------------------------------------------------------------
# Who sees the admin view (#/admin): a JSON list of sign-in addresses, like ["you@example.com"].
ORBITDIFF_ADMIN_EMAILS=[]

# Who may sign in, besides the admins: a JSON list. Leave it empty and anyone with an email
# address can sign in and draw areas, each of which is hours of this machine's work.
ORBITDIFF_INVITED_EMAILS=[]

# --- Email: your provider's SMTP settings ---------------------------------------------------
# Any provider that speaks SMTP with STARTTLS on port 587. For example:
#   Resend    host smtp.resend.com         username resend        password: an API key
#   Postmark  host smtp.postmarkapp.com    username and password: the server API token
#   AWS SES   host email-smtp.<region>.amazonaws.com    username and password: SMTP credentials
ORBITDIFF_SMTP_HOST=
ORBITDIFF_SMTP_PORT=587
ORBITDIFF_SMTP_USERNAME=
# In single quotes if it contains $ or #, which compose would otherwise read as its own.
ORBITDIFF_SMTP_PASSWORD=
# An address on a domain the provider has verified.
ORBITDIFF_MAIL_FROM=Orbit Diff <alerts@your-domain.example>

# --- Backups off this machine (optional, and strongly advised) ------------------------------
# Any S3-compatible bucket: Cloudflare R2, Backblaze B2, AWS S3, ... Left empty, database
# dumps stay in deploy/backups on this machine only, and die with it.
# RCLONE_CONFIG_BACKUP_TYPE=s3
# RCLONE_CONFIG_BACKUP_PROVIDER=Cloudflare
# RCLONE_CONFIG_BACKUP_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID=
# RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY=
# ORBITDIFF_BACKUP_BUCKET=orbitdiff-backups
# ORBITDIFF_BACKUP_KEEP_DAYS=14
