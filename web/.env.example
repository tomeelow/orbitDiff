# Copy to .env.local to override. Nothing here is a secret: Vite puts VITE_* values in the bundle.

# The Orbit Diff API (uv run uvicorn orbitdiff.api:app).
# VITE_API_URL=http://localhost:8000

# Basemaps under the imagery, one per theme. Any MapLibre style URL; the defaults are
# OpenFreeMap (OpenStreetMap data, no key).
# VITE_BASEMAP_DARK=https://tiles.openfreemap.org/styles/dark
# VITE_BASEMAP_LIGHT=https://tiles.openfreemap.org/styles/positron

# The satellite basemap: raster tile templates for the imagery and the place names over it.
# The defaults are Esri World Imagery and World Boundaries and Places (no key).
# VITE_BASEMAP_SATELLITE=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# VITE_BASEMAP_SATELLITE_LABELS=https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}
